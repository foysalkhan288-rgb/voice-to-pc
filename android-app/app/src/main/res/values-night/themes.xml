<?xml version="1.0" encoding="utf-8"?>
<!--
    Night twin of Theme.SpeakType, used when the app runs its dark palette (the default).
    It mirrors com.ashiqe.voicetopc.ui.Palette's dark values so the launch window, the recents
    thumbnail and the system bars are already dark before the first frame is drawn.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SpeakType" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#4FC49A</item>
        <item name="colorPrimaryDark">#0C1210</item>
        <item name="colorAccent">#4FC49A</item>
        <item name="android:colorBackground">#0C1210</item>
        <item name="android:windowBackground">#0C1210</item>
        <item name="android:statusBarColor">#0C1210</item>
        <item name="android:navigationBarColor">#0C1210</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">#E7F0EB</item>
        <item name="android:textColorSecondary">#A2B2AA</item>
        <item name="colorControlNormal">#A2B2AA</item>
        <item name="colorControlActivated">#4FC49A</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
    </style>
</resources>
