<?xml version="1.0" encoding="utf-8"?>
<!--
    Single theme for the phone app. The palette mirrors com.ashiqe.voicetopc.ui.Palette:
    off-white page, deep-emerald accent, light system bars so the status bar never fights the UI.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VoiceToPC" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1F7A57</item>
        <item name="colorPrimaryDark">#186445</item>
        <item name="colorAccent">#1F7A57</item>
        <item name="android:colorBackground">#F5F7F6</item>
        <item name="android:windowBackground">#F5F7F6</item>
        <item name="android:statusBarColor">#F5F7F6</item>
        <item name="android:navigationBarColor">#F5F7F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">#14201B</item>
        <item name="android:textColorSecondary">#55655E</item>
        <item name="colorControlNormal">#55655E</item>
        <item name="colorControlActivated">#1F7A57</item>
        <item name="colorControlHighlight">#1F1F7A57</item>
    </style>
</resources>