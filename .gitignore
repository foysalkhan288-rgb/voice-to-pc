# Python desktop app
windows/.venv/
windows/__pycache__/
*.py[cod]

# Android Studio / Gradle
android-app/.gradle/
android-app/local.properties
android-app/**/build/

# Export package prepared for GitHub Actions upload
/Voice-to-PC-GitHub-build.zip

# Stray build artifacts
*.apk

# PyInstaller build artifacts
windows/build/
windows/dist/
windows/*.spec


# Kotlin/Gradle caches
android-app/.kotlin/

# Keystores - only the shared debug key is tracked; release keys must never be committed
android-app/app/keystore/*.jks
!android-app/app/keystore/speaktype-debug.jks
*.keystore

# Release checksums
SHA256SUMS.txt
